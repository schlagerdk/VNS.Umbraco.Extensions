<Project Sdk="Microsoft.NET.Sdk.Razor">
	<!-- VNS Umbraco Extensions for Umbraco 18: UFM filters and components for the backoffice. Only static files: the
       backoffice code in wwwroot, built from ../src with npm run build. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackageId>VNS.Umbraco.Extensions</PackageId>
		<Version>18.0.0.1</Version>
		<Authors>VNS</Authors>
		<Description>UFM filters and components for the Umbraco backoffice: dateFormat, tagsFormat, badge and media.</Description>
		<PackageTags>umbraco;umbraco-marketplace;vns;ufm</PackageTags>
		<Copyright>2026</Copyright>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<PackageProjectUrl>https://github.com/schlagerdk/VNS.Umbraco.Extensions</PackageProjectUrl>
		<RepositoryUrl>https://github.com/schlagerdk/VNS.Umbraco.Extensions</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<!-- The files in wwwroot are served from /App_Plugins/VNS.Umbraco.Extensions, where Umbraco finds its package
		     manifest. They are not copied into the site's project, but dotnet publish copies them to the publish folder. -->
		<StaticWebAssetBasePath>/</StaticWebAssetBasePath>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<!-- No assembly in the package: it has no .NET code. An assembly would be left in a publish folder that is not
		     cleaned when the package is removed, and Umbraco, which loads every assembly there, would not start
		     (FileNotFoundException: VNS.Umbraco.Extensions). NU5128: the Umbraco dependency is only for the version range. -->
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<NoWarn>$(NoWarn);NU5128</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<None Include="docs\LICENSE.md" Pack="true" PackagePath="\" />
		<None Include="docs\icon.png" Pack="true" PackagePath="\" />
		<None Include="docs\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<!-- Only for the version range: the package is for Umbraco 18 -->
		<PackageReference Include="Umbraco.Cms.Core" Version="[18.0.0, 19.0.0)" />
	</ItemGroup>
	<!-- package.json holds the version (npm run version:set / version:sync). A package is never packed with another
	     version than package.json and umbraco-package.json, so the NuGet package, the backoffice and the git tag agree. -->
	<Target Name="CheckVersion" BeforeTargets="GenerateNuspec">
		<PropertyGroup>
			<NpmVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../package.json')), '"version"\s*:\s*"([^"]*)"').Groups[1].Value)</NpmVersion>
			<UmbracoPackageVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/wwwroot/App_Plugins/VNS.Umbraco.Extensions/umbraco-package.json')), '"version"\s*:\s*"([^"]*)"').Groups[1].Value)</UmbracoPackageVersion>
		</PropertyGroup>
		<Error Condition="'$(NpmVersion)' != '$(Version)' Or '$(UmbracoPackageVersion)' != '$(Version)'" Text="The versions differ: NuGet $(Version), package.json $(NpmVersion), umbraco-package.json $(UmbracoPackageVersion). Run npm run version:sync." />
	</Target>
</Project>
